# ClawRouter Environment Variables
# Copy to .env and fill in your values

# Port for the proxy server (Railway injects PORT automatically)
PORT=8080

# Ethereum private key (hex, 0x-prefixed). Used if no saved wallet exists.
# If not set, ClawRouter generates a new wallet on first run.
# BLOCKRUN_WALLET_KEY=0x...

# Solana RPC endpoint for USDC balance checks
CLAWROUTER_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Set to "true" to disable smart routing (pass requests through as-is)
CLAWROUTER_DISABLED=false

# Set to "1" to enable Worker Mode (earn USDC by running health checks)
# CLAWROUTER_WORKER=1

# Set to "off"/"false"/"0" to suppress x-clawrouter-* debug response headers
CLAWROUTER_DEBUG_HEADERS=on

# Set to "off" to disable BlockRun's Exa web search provider registration
BLOCKRUN_WEB_SEARCH=auto

# Payment chain: "solana" or "base" (overrides persisted selection)
# CLAWROUTER_PAYMENT_CHAIN=base
